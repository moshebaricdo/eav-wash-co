# PostgreSQL connection string (Railway provides this)
DATABASE_URL=postgresql://user:password@host:port/database

# Secret for signing JWT session tokens (generate with: openssl rand -base64 32)
AUTH_SECRET=your-secret-here

# Shared token for estimate lead ingestion from marketing app
LEAD_INGEST_API_KEY=replace-with-a-shared-secret

# Quo (formerly OpenPhone) SMS notifications for new leads
# Generate the API key in Quo workspace settings
QUO_API_KEY=your-quo-api-key
# Your business line (E.164 format, e.g. +15551234567)
QUO_FROM_NUMBER=+15551234567
# Comma-separated notification recipients (E.164 format)
QUO_NOTIFY_TO_NUMBERS=+15557654321
# Optional: send as a specific Quo user
# QUO_USER_ID=usr_123
# Optional: include deep link to the lead in SMS notifications
# CRM_APP_BASE_URL=https://crm.example.com

# Google Places API key for address autocomplete in CRM
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Used only for `npm run db:seed` — initial admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_NAME=Admin

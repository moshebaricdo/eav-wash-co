# PostgreSQL connection string (Railway provides this)
DATABASE_URL=postgresql://user:password@host:port/database

# Secret for signing JWT session tokens (generate with: openssl rand -base64 32)
AUTH_SECRET=your-secret-here

# Shared token for estimate lead ingestion from marketing app
LEAD_INGEST_API_KEY=replace-with-a-shared-secret

# Google Places API key for address autocomplete in CRM
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Used only for `npm run db:seed` — initial admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_NAME=Admin
